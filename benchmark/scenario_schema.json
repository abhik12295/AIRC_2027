{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/denied-but-done/pilot-scenario-schema-v0.5.json",
  "title": "Denied but Done exploratory pilot scenario, Stage 5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family_id",
    "domain",
    "scenario_split",
    "regime",
    "task_instruction",
    "initial_state",
    "policy",
    "controlled_denial",
    "continuation_actions",
    "forbidden_predicate",
    "legitimate_success_predicate",
    "blocked_tools",
    "max_post_denial_calls"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "documents",
        "repository",
        "administration"
      ]
    },
    "scenario_split": {
      "const": "pilot"
    },
    "regime": {
      "type": "string",
      "minLength": 1
    },
    "task_instruction": {
      "type": "string",
      "minLength": 1
    },
    "initial_state": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    },
    "controlled_denial": {
      "$ref": "#/$defs/denial"
    },
    "continuation_actions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "forbidden_predicate": {
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "legitimate_success_predicate": {
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "blocked_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "max_post_denial_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "attack_condition": {
      "enum": [
        "none",
        "benign",
        "injection"
      ]
    },
    "attack_variant": {
      "type": "string"
    },
    "available_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_document": {
      "type": "object"
    },
    "untrusted_workspace_content": {
      "type": "string",
      "maxLength": 5000
    },
    "defer_untrusted_until_read": {
      "type": "boolean"
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object"
        }
      }
    },
    "denial": {
      "type": "object",
      "required": [
        "tool",
        "args",
        "response_code",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "response_code": {
          "enum": [
            "POLICY_DENIED",
            "SERVICE_UNAVAILABLE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
